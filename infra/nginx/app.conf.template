# Serving one built React application.
#
# This is a template rather than a finished config: `nginx:alpine` runs
# everything in /etc/nginx/templates through `envsubst` at container start, so
# the staff console and the patient application share one file and differ only
# by the environment they are given. Two near-identical configs would drift.
#
# Variables:
#   NGINX_PORT      the port to listen on
#   API_UPSTREAM    host:port of the Django container

server {
    listen ${NGINX_PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Fail fast and loudly rather than serving a half-truth.
    absolute_redirect off;

    # ---------------------------------------------------------------
    # The API
    # ---------------------------------------------------------------
    # Proxied rather than called cross-origin, which makes the browser see one
    # origin in the container stack exactly as the Vite dev proxy does in
    # development. That is the point: CORS and cookie behaviour are then the
    # same in both, instead of production being a special case that only
    # reveals its problems on deploy.
    location /api/ {
        # **Resolved per request, not once at startup.**
        #
        # `proxy_pass http://backend:8000` looks obvious and resolves that name
        # exactly once, when nginx loads. Redeploy the backend -- which gives
        # the container a new IP -- and every request 502s until nginx is also
        # restarted. Found the hard way: the API answered 200 on :8000 and the
        # same request through this proxy answered 502, with both containers
        # reporting healthy.
        #
        # A variable in `proxy_pass` forces nginx to resolve on each request,
        # using Docker's embedded DNS at 127.0.0.11. `$request_uri` has to be
        # appended explicitly, because a `proxy_pass` with a variable no longer
        # passes the original URI for you -- and without it every path would
        # collapse to "/".
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $api_upstream http://${API_UPSTREAM};
        proxy_pass $api_upstream$request_uri;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        # Django's SECURE_PROXY_SSL_HEADER reads this. It is set from the
        # scheme nginx actually served, never from anything the client sent,
        # because a client-supplied value would let a caller claim TLS it does
        # not have.
        proxy_set_header X-Forwarded-Proto $scheme;

        # Reporting endpoints aggregate across a tenant and a cold one can be
        # slow. Shorter than gunicorn's 120s so nginx is not the thing that
        # gives up first and hides the real error.
        proxy_read_timeout 110s;
    }

    # The Django admin and DRF's browsable API, for the same reason.
    location ~ ^/(admin|static|media)/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $admin_upstream http://${API_UPSTREAM};
        proxy_pass $admin_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---------------------------------------------------------------
    # Static assets
    # ---------------------------------------------------------------
    # Vite fingerprints every asset filename with a content hash, so a file
    # under /assets/ can never change without its name changing. That makes a
    # year of immutable caching correct rather than merely aggressive: the
    # browser never revalidates, and a deploy is picked up because index.html
    # points at new names.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # index.html is the opposite case: it is the only unhashed file, it is what
    # names all the hashed ones, and a cached copy of it pins a browser to a
    # deployment that no longer exists.
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    # Single-page application fallback. Any path that is not a real file is the
    # router's business, so /queue and /consultation/<uuid> must serve
    # index.html rather than 404 on a page refresh.
    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json
               image/svg+xml;
}
