DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Control-plane database. Tenant databases are provisioned on the same server
# using these credentials unless TENANT_DB_* is overridden.
CONTROL_DATABASE_URL=postgres://nirova:nirova@localhost:5432/nirova_control

TENANT_DB_HOST=localhost
TENANT_DB_PORT=5432
TENANT_DB_USER=nirova
TENANT_DB_PASSWORD=nirova
TENANT_DB_NAME_PREFIX=nirova_tenant_

REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
