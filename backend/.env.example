DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Control-plane database. Tenant databases are provisioned on the same server
# using these credentials unless TENANT_DB_* is overridden.
CONTROL_DATABASE_URL=postgres://nirova:nirova@localhost:5432/nirova_control

TENANT_DB_HOST=localhost
TENANT_DB_PORT=5432
TENANT_DB_USER=nirova
TENANT_DB_PASSWORD=nirova
TENANT_DB_NAME_PREFIX=nirova_tenant_

# **How *this* process reaches a tenant database**, as opposed to where the
# tenant database is recorded as living. `TenantDatabase.host` stores the
# latter and is written when the tenant is provisioned -- inside Docker, where
# Postgres answers to `postgres`. Host-side tooling reaches the same server at
# `localhost`, so without this the seeds and the audits fail with
# `getaddrinfo failed` while the running stack is perfectly healthy.
#
# Set here rather than exported by hand, because "export this before running
# manage.py" is a step everybody forgets once and then debugs for an hour.
# `infra/docker-compose.yml` sets the container's own value explicitly, so
# neither side depends on which file was read first.
NIROVA_TENANT_DB_HOST=localhost
NIROVA_TENANT_DB_PORT=5432

REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
